{
  "name": "i-need-a-job",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local": "node scripts/local.mjs",
    "local:built": "npm run build && npm --prefix server run start:app",
    "admin": "npm --prefix server run admin --",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit --project ui",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run typecheck && npm run test:coverage && npm run build",
    "fixtures:record": "npm --prefix server run record --"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "pdf-lib": "^1.17.1",
    "playwright": "1.55.1",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
