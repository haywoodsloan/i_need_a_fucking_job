# Copy to .env (never commit it). All keys are optional; each one unlocks sources.
# `npm start`, `npm run smoke` and `npm run check:catalog` load .env automatically.

# Frontend origins allowed to call this server (comma separated).
ALLOWED_ORIGINS=https://haywoodsloan.github.io,http://localhost:5173

# Google for Jobs (LinkedIn, Indeed, Glassdoor, ZipRecruiter, Dice, company sites...).
# Set ONE of these three. If more than one is set, the server uses the first in this order and only that one.
# docs/job-sources.md, "Google for Jobs: the key, and what a search costs", has the steps and the costs.
# JSearch with a key from its maker, OpenWeb Ninja: https://www.openwebninja.com/api/jsearch
OPENWEBNINJA_API_KEY=
# JSearch with a key from the RapidAPI marketplace: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# A key only works where it was bought: an OpenWeb Ninja key does not go here.
JSEARCH_API_KEY=
# SerpAPI: https://serpapi.com/google-jobs-api
SERPAPI_KEY=
# Pages of ten postings that one search asks for. Left empty: 2. Every page is one request of the plan, so 1 halves
# what a search costs and what it brings back. At most 20.
GOOGLE_JOBS_PAGES=

# USAJOBS (free): https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com

# Scraping routes (off by default; see docs/job-sources.md for the risks).
ENABLE_LINKEDIN_GUEST=
ENABLE_PLAYWRIGHT=
# Residential proxy for the headless browser, e.g. http://user:pass@host:port
PLAYWRIGHT_PROXY_URL=

# Optional fetch tiers, both off unless set. See docs/fetch-tiers.md.
# A standard headless browser for pages that need JavaScript. It uses Playwright's Chromium, or an installed
# browser when BROWSER_CHANNEL is msedge or chrome.
ENABLE_BROWSER_TIER=
BROWSER_CHANNEL=
# Your own tiers: a module path relative to server/, e.g. ./tiers.local.mjs
FETCH_TIERS_MODULE=

# Accounts and sign-in, off until AUTH_PEPPER is set. See docs/accounts.md.
# Do not write AUTH_PEPPER by hand: "npm run admin -- setup <your email>" creates it in .env and prints your invite.
# Keep a copy of it somewhere safe. If it is lost, nobody can sign in and every stored login is unreadable.
AUTH_PEPPER=
# Earlier secrets, while users move over to a new one: "1:<secret>,2:<secret>". See docs/accounts.md.
AUTH_PEPPER_OLD=
# Where the signed-in app is served from (comma separated). The first one is used in invite and reset links.
# Anything but localhost must be https. Left empty: http://localhost:5173 and this server's own port.
APP_ORIGIN=
# Folder for the local account database. Left empty: server/.data
ACCOUNTS_DATA_DIR=
# New passwords are looked up in a list of breached passwords. Only five characters of a hash leave this server.
# Set to 0 to turn that off.
PASSWORD_BREACH_CHECK=
# How many proxies are in front of this server. Leave it empty when there are none, as on your own machine.
TRUST_PROXY=

PORT=8787
# Which network connections the server answers on. Left empty: this computer only, at http://localhost:8787.
# 0.0.0.0 makes it answer other computers too, which a hosted copy needs. See docs/applications.md before you do
# that on your own computer: a server other computers can reach keeps no applications.
HOST=

# The application tracker (docs/applications.md). It is on by itself where the server answers this computer only.
# Set APPLICATIONS=0 to switch it off.
APPLICATIONS=
# Folder the applications are kept in. Left empty: server/.data/applications
APPLICATIONS_DIR=

# How long search results and answers from job sources are reused.
CACHE_SECONDS=600
# Memory the cache of source answers may use. Large company boards are 30 to 45 MB each.
FETCH_CACHE_MB=128
RATE_LIMIT_PER_5MIN=40
